function set_newskin(){
    let apply=document.querySelector('#sbmtBtn input[name="applyBtn"]');
    setTimeout(()=>{
        if(apply){
            apply.click(); }
    }, 400); }


function complete(){
    let cssCustom=document.querySelector('.cssCustomBtn');
    let link=document.querySelector('.cssCustomBtn a');
    link.setAttribute('href', 'https://blog.ameba.jp/ucs/editcss/srvcssupdateinput.do?sc');
    setTimeout(()=>{
        if(cssCustom){
            link.click(); }
    }, 400); }
